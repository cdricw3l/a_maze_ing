    {
      "id": "2Cz7He89vKRAnVJiDeftB",
      "type": "text",
      "x": 1646.2678615706611,
      "y": 50.53602253422707,
      "width": 1354.6434326171875,
      "height": 496.79999999999995,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
