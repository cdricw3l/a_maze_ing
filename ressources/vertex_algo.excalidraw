      "groupIds": [],
      "frameId": null,
      "index": "b0T",
      "roundness": null,
      "seed": 1494857815,
      "version": 839,
      "versionNonce": 736842857,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "PPRQGhZHHKlQvcsvzueyZ",
          "type": "arrow"
        },
        {
          "id": "mYHtbFDmfwsuhSVh_Jx-Y",
