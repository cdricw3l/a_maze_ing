    {
      "id": "BgZBJk1pCUVxfmElicCtq",
      "type": "text",
      "x": 1929.2498694407104,
      "y": 691.8061913082723,
      "width": 960.8853552308836,
      "height": 124.19999999999999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0g",
