    {
      "id": "BgZBJk1pCUVxfmElicCtq",
      "type": "text",
      "x": 1929.2498694407104,
      "y": 691.8061913082723,
      "width": 960.8853552308836,
      "height": 124.19999999999999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0g",
      "roundness": null,
      "seed": 1067100023,
      "version": 737,
      "versionNonce": 1400578087,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782671902435,
      "link": null,
      "locked": false,
      "text": "For (1, 2) and (2,2) we are checking if\nthe EW connection is open. if EW = 1,1 there is branch N in\nvertex if EW = 0,0 there is no branch N",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For (1, 2) and (2,2) we are checking if\nthe EW connection is open. if EW = 1,1 there is branch N in vertex if EW = 0,0 there is no branch N",
      "autoResize": false,
      "lineHeight": 1.15
    },
    {
      "id": "XrY7TveUAhPuAp9K4bI18",
      "type": "text",
      "x": 1923.7032052767204,
      "y": 911.5613052029599,
      "width": 965.6345499216611,
      "height": 124.19999999999999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0h",
      "roundness": null,
      "seed": 1406754745,
      "version": 660,
      "versionNonce": 224631241,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782671902435,
      "link": null,
      "locked": false,
      "text": "For (1, 2) and (1, 3) we are checking if the SN\nconnection. if SN = 1,1 there is branch W in vertext. If SN = 1,1\nthere is no branch W",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For (1, 2) and (1, 3) we are checking if the SN\nconnection. if SN = 1,1 there is branch W in vertext. If SN = 1,1 there is no branch W",
      "autoResize": false,
      "lineHeight": 1.15
    },
